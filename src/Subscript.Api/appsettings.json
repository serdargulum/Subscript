{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=subscript;Username=subscript;Password=subscript",
    "RabbitMq": "amqp://subscript:subscript@localhost:5673/"
  },
  "Authentication": {
    "ApiKey": "dev-api-key-change-me"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Billing": {
    "SchedulerEnabled": true,
    "SchedulerIntervalSeconds": 60
  },
  "Messaging": {
    "Enabled": true,
    "QueueName": "subscript.billing",
    "PrefetchCount": 1,
    "OutboxPollIntervalSeconds": 5,
    "OutboxBatchSize": 50
  },
  "Host": {
    "ShutdownTimeoutSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
